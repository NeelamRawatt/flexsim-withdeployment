# =====================================================================
# infra/docker/.env.example = TEMPLATE for the secrets of the DATABASE SERVER.
# This file is saved in Git, so it must NEVER contain real passwords.
#
# How to use: copy it to a file named ".env" in this same folder,
# and put real values in the copy. Git ignores ".env".
#
# Tips for passwords: use letters and numbers only, at least 24 characters, and a
# DIFFERENT value for every line. Do not use  $  #  '  "  or spaces (they break the file).
# =====================================================================
# Admin user of PostgreSQL. Only humans and tools use it. Services never do.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
# The door on your computer.
POSTGRES_PORT=5433
# One password per service user. Each service gets only its own.
AUTH_DB_PASSWORD=change_me
EXPERIMENT_DB_PASSWORD=change_me
SIMULATION_DB_PASSWORD=change_me
KPI_DB_PASSWORD=change_me
FILE_DB_PASSWORD=change_me
AI_DB_PASSWORD=change_me