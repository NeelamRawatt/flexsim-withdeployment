# =====================================================================
# .env.example = the LIST of settings kpi-service needs, WITHOUT real values.
# Copy it to ".env" in this folder and fill it in. Never put .env in Git.
# =====================================================================

# kpi-service's OWN database user (made by infra\docker\init-db). Password = KPI_DB_PASSWORD in infra\docker\.env
POSTGRES_USER=kpi_user
POSTGRES_PASSWORD=

# The SAME secret as APP_JWT_SECRET in auth-service (to check login tokens).
APP_JWT_SECRET=
