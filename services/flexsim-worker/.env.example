# =====================================================================
# .env.example = the LIST of settings the worker needs, WITHOUT real values.
# Copy it to ".env" next to flexsim-worker.jar and fill it in. Never put .env in Git.
# =====================================================================

# The WORKER account password (the same as APP_BOOTSTRAP_WORKER_PASSWORD in auth-service).
APP_WORKER_PASSWORD=

# Where the other services are (on your laptop the defaults are localhost and can stay empty).
AUTH_SERVICE_URL=
SIMULATION_SERVICE_URL=
EXPERIMENT_SERVICE_URL=
PARCEL_SERVICE_URL=
KAFKA_BOOTSTRAP_SERVERS=

# FlexSim on this machine.
FLEXSIM_EXE_PATH=C:/Program Files/FlexSim 2025/program/flexsim.exe
FLEXSIM_MODEL_PATH=C:/flexsim-worker/model/Koge Model.fsm
FLEXSIM_WORK_DIR=C:/flexsim-worker/flexsim-runs

# How many FlexSim at the same time (= licences on this VM).
APP_WORKER_MAX_PARALLEL_RUNS=4
